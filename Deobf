-- Deobfuscation logic
local function Deobfuscate(str)
    local result = ""
    for byte in string.gmatch(str, "\\(%d+)") do
        result = result .. string.char(tonumber(byte))
    end
    return result
end

DeobfButton.MouseButton1Click:Connect(function()
    local input = InputBox.Text
    local decoded = Deobfuscate(input)
    OutputBox.Text = decoded
end)

ExecButton.MouseButton1Click:Connect(function()
    local scriptToRun = OutputBox.Text
    loadstring(scriptToRun)()
end)
